TZ=Europe/Berlin
BASE_URL=https://day.example.com
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
# Home location (weather on days spent near home):
# HOME_LAT=52.52
# HOME_LON=13.40
# HOME_PLACE=Berlin
# BACKFILL_DAYS=90
# Sources — every one optional, all editable under Settings → Sources.
# Each takes <NAME>_URL, <NAME>_TOKEN (or _API_KEY) and <NAME>_PUBLIC_URL.
# DAWARICH_URL=https://dawarich.example.com
# DAWARICH_API_KEY=
# IMMICH_URL=http://immich-server:2283
# IMMICH_API_KEY=
# IMMICH_PUBLIC_URL=https://photos.example.com
# MALOJA_URL=http://maloja:42010
# JELLYSTAT_URL=http://jellystat:3000
# JELLYSTAT_API_KEY=
# JELLYSTAT_USER=            # keep only this Jellyfin user's plays
# FIREFLY_URL=http://firefly:8080
# FIREFLY_TOKEN=
# HABITS_URL=http://pocket-habits:8080
# HABITS_TOKEN=
# BOOKSHELF_URL=http://pocket-bookshelf:8080
# BOOKSHELF_TOKEN=
# TRAVEL_URL=http://pocket-travel:8080
# TRAVEL_TOKEN=
# KITCHEN_URL=http://pocket-kitchen:8080
# KITCHEN_TOKEN=
# GARAGE_URL=http://pocket-garage:8080
